# ========================================================
# CONFIGURACIÓN DE BASE DE DATOS - IGLESIA RESTAURACIÓN
# ========================================================

# 1. Opción PostgreSQL (Producción / Local):
# Reemplaza con tus credenciales de PostgreSQL:
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/iglesia_restauracion

# Ejemplo Supabase / Neon / Render:
# DATABASE_URL=postgresql://postgres.xxxx:tu_password@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# 2. Opción SQLite (Desarrollo local sin instalar PostgreSQL):
# DATABASE_URL=sqlite:///./iglesia.db

# Modo de operación:
# 'database' = Conecta directamente a PostgreSQL / SQLite mediante SQLAlchemy
# 'json'     = Lee y escribe en backend/data/*.json
DB_MODE=database

# ========================================================
# SEGURIDAD Y TOKENS JWT
# ========================================================
SECRET_KEY=clave_secreta_super_segura_restauracion_global_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ========================================================
# SERVIDOR
# ========================================================
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
